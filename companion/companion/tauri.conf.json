{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iCUE Edge Companion",
  "version": "0.1.4",
  "identifier": "io.github.inerthel-agi.icue-edge-companion",
  "mainBinaryName": "icue-edge-companion",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "inerthel",
    "copyright": "Copyright (c) 2026 Inerthel. MIT license.",
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
